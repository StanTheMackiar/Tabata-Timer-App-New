{
  "name": "tabata-timer-typescript",
  "private": true,
  "version": "0.1.0",
  "homepage": "./",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host",
    "dev:cap": "node scripts/dev-cap.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "prebuild": "tsc && vite build && cap copy",
    "sync": "yarn prebuild && cap sync",
    "sync:fast": "cap sync",
    "copy": "cap copy",
    "update": "cap update",
    "doctor": "cap doctor",
    "android:open": "cap open android",
    "android:run": "yarn sync && cap run android",
    "android:dev": "cap run android --livereload --external",
    "ios:open": "cap open ios",
    "ios:run": "yarn sync && cap run ios",
    "ios:dev": "cap run ios --livereload --external"
  },
  "dependencies": {
    "@capacitor-community/native-audio": "8.0.0",
    "@capacitor/android": "8.5.1",
    "@capacitor/core": "8.5.1",
    "@capacitor/ios": "8.5.1",
    "howler": "^2.2.4",
    "luxon": "^3.7.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-icons": "^5.6.0",
    "react-router-dom": "^7.15.1",
    "styled-components": "^6.4.2",
    "vite-plugin-html": "^3.2.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.1",
    "@types/howler": "^2.2.13",
    "@types/luxon": "^3.7.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
