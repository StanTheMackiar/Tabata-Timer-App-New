# Credenciales de firma del build de release.
#
# Copia este archivo a android/keystore.properties y rellena los valores.
# keystore.properties está en .gitignore: no lo subas nunca.
#
# storeFile es relativo al módulo app (android/app/), así que la ruta no
# depende de la máquina.

storeFile=keys/release.jks
storePassword=CAMBIA_ESTO
keyAlias=release key
keyPassword=CAMBIA_ESTO
