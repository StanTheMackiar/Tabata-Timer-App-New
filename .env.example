# URL del dev server a la que apunta el WebView nativo (live reload).
# Déjalo comentado para que la app nativa cargue el bundle de dist/.
#
# Con `yarn dev:cap` (hace adb reverse) el emulador resuelve localhost:
# CAP_SERVER_URL=http://localhost:5173
#
# Con un dispositivo iOS o Android en la misma red WiFi, usa la IP de esta máquina:
# CAP_SERVER_URL=http://192.168.1.42:5173
